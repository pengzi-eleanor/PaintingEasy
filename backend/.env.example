# CreatingEasy backend configuration
APP_NAME=CreatingEasy API
APP_ENV=development
# Future providers must read secrets from environment variables. Never commit real keys.
AI_PROVIDER_API_KEY=
AI_PROVIDER=mock
AI_SMART_QUOTA=20

# Public knowledge expansion is enabled by default and can be disabled without an API key.
WIKIDATA_ENABLED=true
CONCEPTNET_ENABLED=false
TENCENT_WORD2VEC_ENABLED=true
TENCENT_WORD2VEC_MODEL_PATH=data/models/light_Tencent_AILab_ChineseEmbedding.bin
TENCENT_WORD2VEC_TOPN=6
TENCENT_WORD2VEC_MIN_SIMILARITY=0.55
WIKIDATA_ENDPOINT=https://www.wikidata.org/w/api.php
CONCEPTNET_ENDPOINT=https://api.conceptnet.io
KNOWLEDGE_USER_AGENT=PaintingEasy/0.1 knowledge-expansion (local deployment)
KNOWLEDGE_CACHE_PATH=data/knowledge_cache.sqlite3
KNOWLEDGE_HTTP_TIMEOUT_SECONDS=2.5
KNOWLEDGE_RETRY_COUNT=1
KNOWLEDGE_CONCURRENCY_LIMIT=2
KNOWLEDGE_CIRCUIT_FAILURE_THRESHOLD=3
KNOWLEDGE_CIRCUIT_COOLDOWN_SECONDS=30
KNOWLEDGE_CACHE_SUCCESS_TTL_SECONDS=2592000
KNOWLEDGE_CACHE_EMPTY_TTL_SECONDS=86400
KNOWLEDGE_CACHE_FAILURE_TTL_SECONDS=300
KNOWLEDGE_CACHE_STALE_TTL_SECONDS=7776000
